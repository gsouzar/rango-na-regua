<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/txtPosicao"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/fundo_posicao"
        android:gravity="center"
        android:textColor="@color/verde_android"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2" />

    <TextView
        android:id="@+id/txtNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/texto"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnVotar"
        app:layout_constraintStart_toEndOf="@id/txtPosicao"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Marmita da Dona Rita" />

    <TextView
        android:id="@+id/txtCategoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/texto_suave"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/txtPosicao"
        app:layout_constraintTop_toBottomOf="@id/txtNome"
        tools:text="Almoço" />

    <TextView
        android:id="@+id/txtPreco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/texto_suave"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@id/txtCategoria"
        app:layout_constraintStart_toEndOf="@id/txtCategoria"
        tools:text="· R$ 22,00" />

    <TextView
        android:id="@+id/txtVotos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/verde_escuro"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/txtCategoria"
        app:layout_constraintStart_toEndOf="@id/txtPreco"
        tools:text="· 10 votos" />

    <Button
        android:id="@+id/btnVotar"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/votar"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
